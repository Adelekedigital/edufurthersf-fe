NEXT_PUBLIC_API_BASE_URL=https://edufurthersf-be-dev.up.railway.app/api/v1
# Optional server-only override for the Next.js API proxy.
EDUFURTHER_API_BASE_URL=https://edufurthersf-be-dev.up.railway.app/api/v1

# --- Internal admin UI (/admin) - server-only, never expose with NEXT_PUBLIC_ ---
# Shared passcode gating /admin sign-in. Also used to sign the admin session
# cookie, so changing it invalidates every existing admin session.
ADMIN_UI_PASSCODE=
# Must match the backend's INTERNAL_SERVICE_TOKEN exactly - sent as
# X-Service-Token on every forwarded /internal/admin/* request.
INTERNAL_SERVICE_TOKEN=

# Configure these only in Vercel Production.
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_BUILD_ENABLED=false
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SUBSTACK_EMBED_URL=
